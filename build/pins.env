# What a fresh image starts with. Sourced by build/build.sh (host) and build/customize.sh (as /tmp/pins.env in
# the chroot), after "build/bump-pins.sh --check" passed: comments and known KEY=value lines of a strict shape only.
# build/bump-pins.sh rewrites the values; the weekly workflow commits that.
# On a running printer Moonraker's update manager moves Klipper, Moonraker and Mainsail past these.

# Klipper master
KLIPPER_COMMIT=ee2c6fb6b00b2b5d097ef70d0868df7d74943b51
# Moonraker master
MOONRAKER_COMMIT=b559b9a81161f958a43c2f527b6ad96f73310d5d
# mainsail-config master
MAINSAIL_CONFIG_COMMIT=ff3869a621db17ce3ef660adbbd3fa321995ac42
# Mainsail release; the zip is https://github.com/mainsail-crew/mainsail/releases/download/$MAINSAIL_VERSION/mainsail.zip
MAINSAIL_VERSION=v2.19.0
MAINSAIL_ZIP_SHA256=c4d9d96f89851c6ae0709c2f20725447f3fe8c57cf193869b0083441bd93378a
# Moonraker speedups, from PyPI
PIP_MSGSPEC_VERSION=0.22.0
PIP_UVLOOP_VERSION=0.23.0
# Build container: multi-arch index digest of debian:trixie
DEBIAN_IMAGE=debian:trixie@sha256:4c25275446ca371766b8b093c696782eabce06263fccacb8d5d813b3dc44b308
