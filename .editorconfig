root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Armbian's boot script uses tabs
[build/boards/*/boot.cmd]
indent_style = tab

# Captured output: keep byte for byte
[{bench/results/**,docs/logs/**,bench/fixtures/**}]
trim_trailing_whitespace = false
insert_final_newline = unset
