[Unit]
Description=KOS: apply /config/kos.conf
After=NetworkManager.service systemd-networkd.service config.mount home-klipper-printer_data.mount
Before=avahi-daemon.service ssh.service nginx.service kos-mcu-discover.service klipper.service moonraker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/kos/kos-config

[Install]
WantedBy=multi-user.target
