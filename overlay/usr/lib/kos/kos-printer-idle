#!/usr/bin/env python3
"""Exit 0 only if the printer is idle: kos-security-updates.service's ExecCondition.

Idle: Klippy shut down, or Klippy ready with no job printing or paused and no gcode running (idle_timeout).
Anything else exits 1, including Moonraker not answering and Klippy starting up or in error;
systemd then skips the update run without calling it a failure.

Usage: kos-printer-idle     Self-test: kos-printer-idle --test
"""
import json, os, sys, urllib.request

URL = os.environ.get("MOONRAKER_URL", "http://127.0.0.1:7125")


def get(path):
    with urllib.request.urlopen(URL + path, timeout=10) as r:
        return json.load(r)["result"]


def idle():
    """(is_idle, reason)."""
    try:
        klippy = get("/server/info")["klippy_state"]
        if klippy == "shutdown":
            return True, "klippy shut down"
        if klippy != "ready":
            return False, f"klippy {klippy}"
        s = get("/printer/objects/query?print_stats&idle_timeout")["status"]
        job, busy = s["print_stats"]["state"], s["idle_timeout"]["state"]
    except Exception as e:
        return False, f"moonraker not answering ({e})"
    if job in ("printing", "paused") or busy == "Printing":
        return False, f"printer busy (job {job}, {busy})"
    return True, f"printer idle (job {job})"


def test():
    import http.server, threading
    global URL
    state = {}

    class H(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a): pass
        def do_GET(self):
            if self.path == "/server/info":
                res = {"klippy_state": state["klippy"]}
            else:
                res = {"status": {"print_stats": {"state": state["job"]}, "idle_timeout": {"state": state["busy"]}}}
            body = json.dumps({"result": res}).encode()
            self.send_response(200); self.send_header("Content-Length", str(len(body))); self.end_headers(); self.wfile.write(body)

    srv = http.server.HTTPServer(("127.0.0.1", 0), H)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    URL = f"http://127.0.0.1:{srv.server_port}"
    for klippy, job, busy, want in [("ready", "standby", "Idle", True), ("ready", "complete", "Ready", True),
                                    ("ready", "printing", "Printing", False), ("ready", "paused", "Ready", False),
                                    ("ready", "standby", "Printing", False), ("shutdown", "printing", "Printing", True),
                                    ("startup", "standby", "Idle", False), ("error", "standby", "Idle", False)]:
        state.update(klippy=klippy, job=job, busy=busy)
        assert idle()[0] is want, (klippy, job, busy)
    srv.shutdown(); srv.server_close()
    assert idle()[0] is False   # Moonraker not answering
    print("ok")


if __name__ == "__main__":
    if "--test" in sys.argv:
        sys.exit(test())
    ok, why = idle()
    print(why)
    sys.exit(0 if ok else 1)
